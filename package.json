{
  "name": "mdwisp",
  "version": "0.1.14",
  "private": true,
  "description": "Minimalist, privacy-first, cross-platform Markdown editor",
  "license": "Apache-2.0",
  "homepage": "https://gailleur.com",
  "repository": "github:gailleur/mdwisp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/kit": "^7.23.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "mdast-util-math": "^3.0.0",
    "mermaid": "^12.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tauri-apps/cli": "^2.12.4",
    "@types/katex": "^0.16.7",
    "@types/mdast": "^4.0.4",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "micromark": "4.0.2",
      "micromark-core-commonmark": "2.0.3"
    }
  }
}
